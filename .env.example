APP_NAME=wheelmaker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wheelmaker.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Outbound mail: Amazon SES SMTP (us-east-1). The domain is verified in
# SES; credentials are an IAM user with ses:SendRawEmail, converted to an
# SMTP password. Never commit real values.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=<redacted>
MAIL_FROM_ADDRESS="noreply@wheelmaker.dev"
MAIL_FROM_NAME="wheelmaker.dev"

# Google reCAPTCHA v3 secret for the contact form + resume download.
# Optional: when empty, the server skips the Google check and relies on
# the honeypot field + rate limiting. Site key lives in config/app.php.
GOOGLE_RECAPTCHA_SECRET=
